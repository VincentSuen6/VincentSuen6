{
  "name": "SOAR — Multi-Vendor Alert Normalization",
  "nodes": [
    {
      "id": "webhook-receiver",
      "name": "Receive Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "soar-ingest",
        "responseMode": "onReceived",
        "responseData": "firstEntryJson",
        "options": {}
      }
    },
    {
      "id": "detect-vendor",
      "name": "Detect Alert Vendor",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [440, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.manager !== undefined || $json.body.agent !== undefined ? 'wazuh' : $json.body.result !== undefined ? 'splunk' : 'elastic' }}",
        "rules": {
          "rules": [
            { "value2": "wazuh",   "output": 0 },
            { "value2": "splunk",  "output": 1 },
            { "value2": "elastic", "output": 2 }
          ]
        },
        "fallbackOutput": 2
      }
    },
    {
      "id": "normalize-wazuh",
      "name": "Normalize Wazuh Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 160],
      "parameters": {
        "jsCode": "const alert = $input.item.json.body;\nconst data = alert.data || {};\nconst rule = alert.rule || {};\n\nreturn [{\n  json: {\n    alert_id:        `wazuh-${alert.id || Date.now()}`,\n    vendor:          'Wazuh',\n    alert_type:      rule.description || 'Wazuh Security Alert',\n    source_ip:       data.srcip || data.src_ip || alert.agent?.ip || '0.0.0.0',\n    target_host:     alert.agent?.name || alert.manager?.name || 'unknown',\n    failed_attempts: parseInt(data.failed_logins || rule.firedtimes || 0),\n    raw_log:         alert.full_log || JSON.stringify(alert),\n    rule_id:         rule.id,\n    rule_level:      rule.level,\n    mitre_ids:       (rule.mitre?.id || []),\n    _original:       alert,\n  }\n}];"
      }
    },
    {
      "id": "normalize-splunk",
      "name": "Normalize Splunk Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "parameters": {
        "jsCode": "const alert = $input.item.json.body;\nconst result = alert.result || {};\n\nreturn [{\n  json: {\n    alert_id:        `splunk-${alert.sid || Date.now()}`,\n    vendor:          'Splunk',\n    alert_type:      alert.search_name || 'Splunk Triggered Rule',\n    source_ip:       result.src_ip || result.src || result.clientip || '0.0.0.0',\n    target_host:     result.dest || result.host || result.dest_host || 'unknown',\n    failed_attempts: parseInt(result.count || result.failures || 0),\n    raw_log:         result._raw || JSON.stringify(result),\n    _original:       alert,\n  }\n}];"
      }
    },
    {
      "id": "normalize-elastic",
      "name": "Normalize Elastic Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 440],
      "parameters": {
        "jsCode": "const alert = $input.item.json.body;\nconst source = alert.source || {};\nconst destination = alert.destination || {};\nconst kibanaRule = alert['kibana.alert.rule.name'] || 'Elastic Security Alert';\n\nreturn [{\n  json: {\n    alert_id:        `elastic-${alert['kibana.alert.uuid'] || Date.now()}`,\n    vendor:          'Elastic',\n    alert_type:      kibanaRule,\n    source_ip:       source.ip || alert['source.ip'] || '0.0.0.0',\n    target_host:     destination.address || alert['host.name'] || 'unknown',\n    failed_attempts: parseInt(alert['kibana.alert.rule.execution.metrics.total_alerts_count'] || 0),\n    raw_log:         alert.message || JSON.stringify(alert),\n    risk_score:      alert['kibana.alert.risk_score'],\n    severity:        alert['kibana.alert.severity'],\n    _original:       alert,\n  }\n}];"
      }
    },
    {
      "id": "drop-invalid-ip",
      "name": "Drop Missing / Private IP",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [920, 300],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.source_ip }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.source_ip }}",
              "operation": "notEqual",
              "value2": "0.0.0.0"
            },
            {
              "value1": "={{ $json.source_ip.startsWith('10.') || $json.source_ip.startsWith('192.168.') || $json.source_ip.startsWith('172.16.') }}",
              "operation": "notEqual",
              "value2": "true"
            }
          ]
        },
        "combineConditions": "AND"
      }
    },
    {
      "id": "forward-to-soar",
      "name": "POST to SOAR Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1160, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOAR_API_URL }}/api/v1/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.SOAR_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alert_id",        "value": "={{ $json.alert_id }}" },
            { "name": "vendor",          "value": "={{ $json.vendor }}" },
            { "name": "alert_type",      "value": "={{ $json.alert_type }}" },
            { "name": "source_ip",       "value": "={{ $json.source_ip }}" },
            { "name": "target_host",     "value": "={{ $json.target_host }}" },
            { "name": "failed_attempts", "value": "={{ $json.failed_attempts }}" },
            { "name": "raw_log",         "value": "={{ $json.raw_log }}" }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 2000
          },
          "timeout": 15000
        }
      }
    },
    {
      "id": "log-dropped",
      "name": "Log Dropped Alert",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [920, 520],
      "parameters": {}
    },
    {
      "id": "response-ok",
      "name": "Respond 202 Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1380, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'forwarded', soar_response: $json }) }}",
        "options": { "responseCode": 202 }
      }
    }
  ],
  "connections": {
    "Receive Alert Webhook": {
      "main": [[{ "node": "Detect Alert Vendor", "type": "main", "index": 0 }]]
    },
    "Detect Alert Vendor": {
      "main": [
        [{ "node": "Normalize Wazuh Alert",   "type": "main", "index": 0 }],
        [{ "node": "Normalize Splunk Alert",  "type": "main", "index": 0 }],
        [{ "node": "Normalize Elastic Alert", "type": "main", "index": 0 }]
      ]
    },
    "Normalize Wazuh Alert":   { "main": [[{ "node": "Drop Missing / Private IP", "type": "main", "index": 0 }]] },
    "Normalize Splunk Alert":  { "main": [[{ "node": "Drop Missing / Private IP", "type": "main", "index": 0 }]] },
    "Normalize Elastic Alert": { "main": [[{ "node": "Drop Missing / Private IP", "type": "main", "index": 0 }]] },
    "Drop Missing / Private IP": {
      "main": [
        [{ "node": "POST to SOAR Engine", "type": "main", "index": 0 }],
        [{ "node": "Log Dropped Alert",   "type": "main", "index": 0 }]
      ]
    },
    "POST to SOAR Engine": {
      "main": [[{ "node": "Respond 202 Accepted", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false
  },
  "id": "soar-alert-normalization-v1"
}
