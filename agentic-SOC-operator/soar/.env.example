# Copy this file to .env and fill in real values before running.
# docker-compose.yml reads ${VAR:-} placeholders from .env automatically.

# --- Message broker ---
CELERY_BROKER_URL=amqp://localhost:5672//

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Postgres (LangGraph checkpointer) ---
POSTGRES_CONN=postgresql://soar:soar@localhost:5432/soar

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Threat intelligence ---
VT_API_KEY=                   # VirusTotal free tier key (optional — fallback score applied)

# --- SIEM audit output ---
SPLUNK_HEC_URL=               # e.g. https://splunk.internal:8088
SPLUNK_HEC_TOKEN=             # HEC token from Splunk Settings → Data Inputs

# --- Tuning ---
CORS_ORIGINS=http://localhost:3000
THREAT_SCORE_THRESHOLD=7.5    # VT score >= this triggers HITL approval prompt
BRUTE_FORCE_MIN_ATTEMPTS=3    # below this, brute-force alerts are filtered as noise
DEDUP_WINDOW_SECONDS=600      # Redis sliding-window TTL for alert_id dedup
BLOCKED_IP_TTL_SECONDS=86400  # 24 h TTL on iptables block registry entries
LOOKBACK_WINDOW_SECONDS=600   # Qdrant vector lookback window for semantic dedup
SIMILARITY_THRESHOLD=0.90     # cosine score threshold for clustering alerts
SSE_PUSH_INTERVAL_SECONDS=2   # how often the server pushes metrics to the dashboard
