# AegisLoop Environment Configuration
# Copy to .env and populate before running

# Target
AEGIS_TARGET_URL=http://localhost:8080
AEGIS_REQUEST_TIMEOUT=10
AEGIS_RATE_LIMIT_DELAY=0.5

# Assessment identity (written into reports and Navigator layers)
AEGIS_ASSESSMENT_ID=
AEGIS_ASSESSOR=Purple Team

# Reporting
AEGIS_REPORT_DIR=./reports
AEGIS_NAVIGATOR_DIR=./navigator-data

# WAF log path (mounted from the modsecurity container)
AEGIS_WAF_LOG_PATH=./waf-logs/access.log
